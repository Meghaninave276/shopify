<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@phosphor-icons/web/src/regular/style.css" />

<style>
  .shopdev .trust-badges-bar {
    background-color: {{ section.settings.background_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .shopdev .trust-badges-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  @media (min-width: 640px) {
    .shopdev .trust-badges-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .shopdev .trust-badges-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .shopdev .trust-badge-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 24px 16px;
  }

  .shopdev .trust-badge-icon-wrapper {
    width: 64px;
    height: 64px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ section.settings.icon_background_color }};
    flex-shrink: 0;
  }

  .shopdev .trust-badge-icon-wrapper i {
    font-size: 28px;
    color: {{ section.settings.icon_color }};
  }

  .shopdev .trust-badge-icon-wrapper img {
    width: 32px;
    height: 32px;
    object-fit: contain;
  }

  .shopdev .trust-badge-content {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .shopdev .trust-badge-heading {
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: {{ section.settings.heading_color }};
    margin: 0;
    line-height: 1.3;
  }

  .shopdev .trust-badge-description {
    font-size: 14px;
    font-weight: 400;
    color: {{ section.settings.description_color }};
    margin: 0;
    line-height: 1.5;
    opacity: 0.85;
  }

  /* Divider between items on desktop */
  @media (min-width: 1024px) {
    .shopdev .trust-badge-item {
      position: relative;
    }

    .shopdev .trust-badge-item:not(:last-child)::after {
      content: '';
      position: absolute;
      right: -16px;
      top: 20%;
      height: 60%;
      width: 1px;
      background-color: {{ section.settings.icon_background_color }};
    }
  }
</style>

<div class="trust-badges-bar">
  {% if section.blocks.size > 0 %}
    <div class="trust-badges-grid">
      {% for block in section.blocks %}
        <div class="trust-badge-item" {{ block.shopify_attributes }}>
          <!-- Icon -->
          <div class="trust-badge-icon-wrapper">
            {% if block.settings.custom_icon != blank %}
              {{ block.settings.custom_icon | image_url: width: 64 | image_tag:
                loading: 'lazy',
                class: '',
                alt: block.settings.heading
              }}
            {% else %}
              {% case block.settings.icon %}
                {% when 'truck' %}
                  <i class="ph ph-truck"></i>
                {% when 'arrow-counter-clockwise' %}
                  <i class="ph ph-arrow-counter-clockwise"></i>
                {% when 'shield-check' %}
                  <i class="ph ph-shield-check"></i>
                {% when 'certificate' %}
                  <i class="ph ph-certificate"></i>
                {% when 'lock' %}
                  <i class="ph ph-lock"></i>
                {% when 'heart' %}
                  <i class="ph ph-heart"></i>
                {% when 'diamond' %}
                  <i class="ph ph-diamond"></i>
                {% when 'gift' %}
                  <i class="ph ph-gift"></i>
                {% when 'headset' %}
                  <i class="ph ph-headset"></i>
                {% when 'star' %}
                  <i class="ph ph-star"></i>
                {% else %}
                  <i class="ph ph-check-circle"></i>
              {% endcase %}
            {% endif %}
          </div>

          <!-- Text Content -->
          <div class="trust-badge-content">
            {% if block.settings.heading != blank %}
              <h3 class="trust-badge-heading">{{ block.settings.heading }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="trust-badge-description">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </div>
  {% else %}
    <div style="text-align: center; padding: 40px 24px; color: {{ section.settings.description_color }};">
      <p>Add trust badge blocks to get started.</p>
    </div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Trust Badges Bar",
  "class": "shopdev",
  "tag": "section",
  "settings": [
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#013A2D"
    },
    {
      "type": "color",
      "id": "icon_background_color",
      "label": "Icon Background Color",
      "default": "#05503F"
    },
    {
      "type": "color",
      "id": "icon_color",
      "label": "Icon Color",
      "default": "#85966B"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "description_color",
      "label": "Description Color",
      "default": "#E5DBC7"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "max_blocks": 4,
  "blocks": [
    {
      "type": "badge",
      "name": "Trust Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Delivery Truck"
            },
            {
              "value": "arrow-counter-clockwise",
              "label": "Returns Arrow"
            },
            {
              "value": "shield-check",
              "label": "Shield Check"
            },
            {
              "value": "certificate",
              "label": "Certificate"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "diamond",
              "label": "Diamond"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "headset",
              "label": "Customer Support"
            },
            {
              "value": "star",
              "label": "Star"
            }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom Icon Image",
          "info": "Upload a custom icon to override the default icon selection."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Free Delivery"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "On all orders over $150"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust Badges Bar",
      "settings": {
        "background_color": "#013A2D",
        "icon_background_color": "#05503F",
        "icon_color": "#85966B",
        "heading_color": "#FFFFFF",
        "description_color": "#E5DBC7",
        "padding_top": 40,
        "padding_bottom": 40
      },
      "blocks": [
        {
          "type": "badge",
          "settings": {
            "icon": "truck",
            "heading": "Free Delivery",
            "description": "Complimentary shipping on all jewelry orders over $150"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "arrow-counter-clockwise",
            "heading": "Easy Returns",
            "description": "Hassle-free 30-day returns & exchanges on all pieces"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "lock",
            "heading": "Secure Payment",
            "description": "Your transactions are protected with SSL encryption"
          }
        },
        {
          "type": "badge",
          "settings": {
            "icon": "certificate",
            "heading": "100% Authentic",
            "description": "Every piece comes with a certificate of authenticity"
          }
        }
      ]
    }
  ]
}
{% endschema %}