<style>

:root{
  --dark-green:#013A2D;
  --sage-green:#85966B;
  --cream:#E5DBC7;
  --white:#ffffff;
}

*{
  margin:0;
  padding:0;
  box-sizing:border-box;
}

.jewel-navbar{
  width:100%;
  background:var(--dark-green);
  border-bottom:1px solid rgba(229,219,199,0.15);
  padding:16px 45px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  font-family:"Poppins", sans-serif;
  position:sticky;
  top:0;
  z-index:999;
}

/* LOGO */
.jewel-logo{
  font-size:32px;
  font-weight:700;
  color:var(--cream);
  letter-spacing:1px;
}

.jewel-logo span{
  color:var(--sage-green);
  font-weight:500;
}

/* MENU */
.jewel-menu{
  display:flex;
  gap:32px;
  align-items:center;
}

.jewel-menu a{
  text-decoration:none;
  color:var(--cream);
  font-size:15px;
  font-weight:500;
  transition:0.3s ease;
  position:relative;
}

.jewel-menu a:hover{
  color:var(--sage-green);
}

.jewel-menu a.active{
  color:var(--sage-green);
}

.jewel-menu a.active::after,
.jewel-menu a:hover::after{
  content:"";
  position:absolute;
  width:100%;
  height:2px;
  background:var(--sage-green);
  left:0;
  bottom:-8px;
  border-radius:20px;
}

/* RIGHT */
.jewel-right{
  display:flex;
  align-items:center;
  gap:18px;
}

/* SEARCH */
.jewel-search{
  background:rgba(255,255,255,0.08);
  border:1px solid rgba(229,219,199,0.15);
  border-radius:40px;
  padding:10px 18px;
  display:flex;
  align-items:center;
}

.jewel-search input{
  border:none;
  background:transparent;
  outline:none;
  width:180px;
  font-size:14px;
  color:var(--cream);
}

.jewel-search input::placeholder{
  color:#d6ccb8;
}

/* ICONS */
.jewel-icon{
  position:relative;
  cursor:pointer;
  font-size:22px;
  color:var(--cream);
  transition:0.3s ease;
  text-decoration:none;
}

.jewel-icon:hover{
  color:var(--sage-green);
}

.jewel-count{
  position:absolute;
  top:-7px;
  right:-10px;
  background:var(--sage-green);
  color:var(--white);
  font-size:10px;
  width:18px;
  height:18px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:600;
}

/* BUTTON */
.jewel-btn{
  background:var(--cream);
  color:var(--dark-green);
  padding:11px 24px;
  border-radius:40px;
  text-decoration:none;
  font-size:14px;
  font-weight:600;
  transition:0.3s ease;
}

.jewel-btn:hover{
  background:var(--sage-green);
  color:var(--white);
  transform:translateY(-2px);
}

/* MOBILE TOGGLE */
.jewel-toggle{
  display:none;
  font-size:30px;
  color:var(--cream);
  cursor:pointer;
}

/* MOBILE */
@media(max-width:991px){

  .jewel-navbar{
    flex-wrap:wrap;
    padding:18px 20px;
  }

  .jewel-logo{
    font-size:26px;
  }

  .jewel-toggle{
    display:block;
  }

  .jewel-menu{
    width:100%;
    display:none;
    flex-direction:column;
    align-items:flex-start;
    gap:20px;
    padding-top:25px;
  }

  .jewel-menu.active{
    display:flex;
  }

  .jewel-right{
    width:100%;
    display:none;
    flex-direction:column;
    align-items:flex-start;
    gap:18px;
    padding-top:20px;
  }

  .jewel-right.active{
    display:flex;
  }

  .jewel-search{
    width:100%;
  }

  .jewel-search input{
    width:100%;
  }

  .jewel-btn{
    width:100%;
    text-align:center;
  }

}

</style>

<header class="jewel-navbar">

  <!-- Logo -->
  <div class="jewel-logo">
    Luxe<span>Jewels</span>
  </div>

  <!-- Hamburger -->
  <div class="jewel-toggle" id="jewelToggle">
    ☰
  </div>

  <!-- Navigation -->
  <nav class="jewel-menu" id="jewelMenu">
    <a href="/" class="active">Home</a>
    <a href="/collections/rings">Rings</a>
    <a href="/collections/necklaces">Necklaces</a>
    <a href="/collections/earrings">Earrings</a>
    <a href="/collections/bracelets">Bracelets</a>
    <a href="/pages/about">About</a>
  </nav>

  <!-- Right Section -->
  <div class="jewel-right" id="jewelRight">

    <!-- Search -->
    <form action="/search" method="get" class="jewel-search">
      <input type="text" name="q" placeholder="Search jewellery...">
    </form>

    <!-- Wishlist -->
    <a href="/pages/wishlist" class="jewel-icon">
      ♡
      <span class="jewel-count">2</span>
    </a>

    <!-- Cart -->
    <a href="/cart" class="jewel-icon">
      🛍
      <span class="jewel-count">{{ cart.item_count }}</span>
    </a>

    <!-- Button -->
    <a href="/account" class="jewel-btn">
      My Account
    </a>

  </div>

</header>

<script>

const toggle = document.getElementById('jewelToggle');
const menu = document.getElementById('jewelMenu');
const right = document.getElementById('jewelRight');

toggle.addEventListener('click', function(){

  menu.classList.toggle('active');
  right.classList.toggle('active');

  if(toggle.innerHTML === '☰'){
    toggle.innerHTML = '✕';
  } else {
    toggle.innerHTML = '☰';
  }

});

</script>