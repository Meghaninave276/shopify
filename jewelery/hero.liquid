<!-- =========================
  SLICK CSS
========================= -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css">

{% schema %}
{
  "name": "Luxury Dynamic Slider",
  "tag": "section",
  "class": "luxury-dynamic-slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Slide Image"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "text",
          "id": "highlight_text",
          "label": "Highlight Text"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_1_text",
          "label": "Button 1 Text"
        },
        {
          "type": "url",
          "id": "button_1_link",
          "label": "Button 1 Link"
        },
        {
          "type": "text",
          "id": "button_2_text",
          "label": "Button 2 Text"
        },
        {
          "type": "url",
          "id": "button_2_link",
          "label": "Button 2 Link"
        },
        {
          "type": "text",
          "id": "rating_text",
          "label": "Rating Text"
        },
        {
          "type": "text",
          "id": "offer_text",
          "label": "Offer Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Luxury Dynamic Slider"
    }
  ]
}
{% endschema %}

<style>
  /* =========================
   ROOT
========================= */
:root{
  --dark-green:#013A2D;
  --sage-green:#8C9A78;
  --cream:#E7E0D4;
  --text:#555555;
  --white:#ffffff;
}

/* =========================
   MAIN SECTION
========================= */
.lux-slider-main{
  width:100%;
  overflow:hidden;
  background:var(--cream);
  position:relative;
}

.lux-slider-main *{
  box-sizing:border-box;
}

.lux-slider-main img{
  max-width:100%;
  display:block;
}

/* =========================
   SLICK FIX
========================= */
.lux-slider-active{
  width:100%;
}

.lux-slider-active .slick-list{
  overflow:hidden;
}

{% comment %} .lux-slider-active .slick-track{
  display:flex !important;
}

.lux-slider-active .slick-slide{
  height:inherit !important;
} {% endcomment %}

.lux-slider-active .slick-slide > div{
  height:100%;
}

/* =========================
   SLIDE ITEM
========================= */
.lux-slide-item{
  width:100%;
  min-height:760px;

  display:flex !important;
  align-items:center;
  justify-content:space-between;

  gap:80px;

  padding:80px 7%;
}

/* =========================
   LEFT CONTENT
========================= */
.lux-left{
  flex:0 0 52%;
  max-width:52%;

  display:flex;
  flex-direction:column;
  justify-content:center;
  align-items:flex-start;
}

/* =========================
   BADGE
========================= */
.lux-badge{
  display:inline-flex;
  align-items:center;
  justify-content:center;

  background:var(--sage-green);
  color:var(--white);

  padding:12px 26px;

  border-radius:50px;

  font-size:14px;
  font-weight:600;

  margin-bottom:28px;
}

/* =========================
   HEADING
========================= */
.lux-heading{
  font-size:78px;
  line-height:1.05;
  font-weight:800;

  color:var(--dark-green);

  margin:0 0 28px;
}

.lux-heading span{
  display:block;
  color:var(--sage-green);
  margin-top:8px;
}

/* =========================
   DESCRIPTION
========================= */
.lux-desc{
  font-size:21px;
  line-height:1.9;

  color:var(--text);

  max-width:650px;

  margin-bottom:45px;
}

/* =========================
   BUTTONS
========================= */
.lux-btn-wrap{
  display:flex;
  align-items:center;
  gap:20px;
  flex-wrap:wrap;
}

.lux-btn-primary{
  display:inline-flex;
  align-items:center;
  justify-content:center;

  min-width:200px;

  background:var(--dark-green);
  color:var(--white);

  text-decoration:none;

  padding:18px 40px;

  border-radius:60px;

  font-size:16px;
  font-weight:700;

  transition:0.3s ease;
}

.lux-btn-primary:hover{
  transform:translateY(-3px);
}

.lux-btn-secondary{
  display:inline-flex;
  align-items:center;
  justify-content:center;

  min-width:220px;

  border:2px solid var(--dark-green);

  color:var(--dark-green);

  text-decoration:none;

  padding:16px 38px;

  border-radius:60px;

  font-size:16px;
  font-weight:700;

  transition:0.3s ease;
}

.lux-btn-secondary:hover{
  background:var(--dark-green);
  color:var(--white);
}

/* =========================
   RIGHT IMAGE
========================= */
.lux-right{
  flex:0 0 48%;
  max-width:48%;

  display:flex;
  justify-content:center;
  align-items:center;
}

/* =========================
   IMAGE CARD
========================= */
.lux-image-box{
  position:relative;

  width:100%;
  max-width:560px;

  padding:28px;

  border-radius:42px;

  background:rgba(255,255,255,0.45);

  overflow:hidden;

  box-shadow:0 20px 50px rgba(0,0,0,0.08);
}

/* =========================
   IMAGE
========================= */
.lux-slide-image{
    width:100%;
  height:620px;
  object-fit:cover;
  border-radius:28px;
  display:block;
}

/* =========================
   FLOATING CARDS
========================= */
.lux-rating{
  position:absolute;

  top:20px;
  right:20px;

  background:#fff;

  padding:14px 22px;

  border-radius:18px;

  font-size:14px;
  font-weight:700;

  color:var(--dark-green);

  box-shadow:0 8px 25px rgba(0,0,0,0.08);
}

.lux-offer{
  position:absolute;

  left:20px;
  bottom:20px;

  background:#fff;

  padding:14px 22px;

  border-radius:18px;

  font-size:14px;
  font-weight:700;

  color:var(--sage-green);

  box-shadow:0 8px 25px rgba(0,0,0,0.08);
}

/* =========================
   ARROWS
========================= */
.slick-prev,
.slick-next{
  width:50px;
  height:50px;

  z-index:99;
}

.slick-prev{
  left:20px;
}

.slick-next{
  right:20px;
}

.slick-prev:before,
.slick-next:before{
  color:var(--dark-green);
  font-size:28px;
}
.slick-slide img{
  display:block !important;
  width:100%;
}
/* =========================
   DOTS
========================= */
.slick-dots{
  bottom:20px;
}

.slick-dots li button:before{
  color:var(--dark-green);
}

/* =========================
   TABLET
========================= */
@media(max-width:1100px){

  .lux-slide-item{
    gap:50px;
  }

  .lux-heading{
    font-size:58px;
  }

  .lux-desc{
    font-size:18px;
  }

  .lux-slide-image{
    height:520px;
  }

}

/* =========================
   MOBILE
========================= */
@media(max-width:991px){

  .lux-slider-main{
    overflow:visible !important;
  }

  .lux-slider-active,
  .slick-list,
  .slick-track,
  .slick-slide,
  .slick-slide > div{
    height:auto !important;
  }

  .lux-slide-item{
    display:flex !important;
    flex-direction:column !important;

    padding:60px 20px !important;
    gap:40px;

    min-height:auto !important;
    height:auto !important;
  }

  .lux-left,
  .lux-right{
    width:100% !important;
    max-width:100% !important;
    flex:0 0 100% !important;
  }

  .lux-left{
    align-items:center;
    text-align:center;
  }

  .lux-image-box{
    width:100%;
    max-width:100%;
    padding:15px;
    overflow:visible;
  }

  .lux-slide-image{
    width:100% !important;
    height:auto !important;
    max-height:none !important;
    min-height:auto !important;
    display:block !important;
  }

}
/* =========================
   SMALL MOBILE
========================= */
@media(max-width:575px){

  .lux-slide-item{
    padding:50px 15px;
  }

  .lux-heading{
    font-size:36px;
  }

  .lux-desc{
    font-size:15px;
    line-height:1.7;
  }

  .lux-btn-primary,
  .lux-btn-secondary{
    width:100%;
    min-width:100%;
  }

  .lux-image-box{
    padding:18px;
  }

  .lux-rating,
  .lux-offer{
    font-size:12px;
    padding:10px 16px;
  }

}
  </style>

<!-- =========================
   HTML
========================= -->
<section class="lux-slider-main">

  <div class="lux-slider-active">

    {% for block in section.blocks %}

      <div class="lux-slide-item" {{ block.shopify_attributes }}>

        <!-- LEFT -->
        <div class="lux-left">

          {% if block.settings.badge_text != blank %}
            <div class="lux-badge">
              {{ block.settings.badge_text }}
            </div>
          {% endif %}

          {% if block.settings.heading != blank %}
            <h2 class="lux-heading">

              {{ block.settings.heading }}

              {% if block.settings.highlight_text != blank %}
                <span>{{ block.settings.highlight_text }}</span>
              {% endif %}

            </h2>
          {% endif %}

          {% if block.settings.description != blank %}
            <div class="lux-desc">
              {{ block.settings.description }}
            </div>
          {% endif %}

          <div class="lux-btn-wrap">

            {% if block.settings.button_1_text != blank and block.settings.button_1_link != blank %}
              <a href="{{ block.settings.button_1_link }}" class="lux-btn-primary">
                {{ block.settings.button_1_text }}
              </a>
            {% endif %}

            {% if block.settings.button_2_text != blank and block.settings.button_2_link != blank %}
              <a href="{{ block.settings.button_2_link }}" class="lux-btn-secondary">
                {{ block.settings.button_2_text }}
              </a>
            {% endif %}

          </div>

        </div>

        <!-- RIGHT -->
        <div class="lux-right">

          <div class="lux-image-box">

            {% if block.settings.image != blank %}

              {{
                block.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  class: 'lux-slide-image',
                  alt: block.settings.heading
              }}

            {% endif %}

            {% if block.settings.rating_text != blank %}
              <div class="lux-rating">
                {{ block.settings.rating_text }}
              </div>
            {% endif %}

            {% if block.settings.offer_text != blank %}
              <div class="lux-offer">
                🔥 {{ block.settings.offer_text }}
              </div>
            {% endif %}

          </div>

        </div>

      </div>

    {% endfor %}

  </div>

</section>

<!-- =========================
   JQUERY
========================= -->
{% unless content_for_header contains 'jquery' %}
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
{% endunless %}

<!-- =========================
   SLICK JS
========================= -->
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<!-- =========================
   SLICK INIT
========================= -->
<script>

document.addEventListener("DOMContentLoaded", function () {

  const slider = $('.lux-slider-active');

  if (slider.hasClass('slick-initialized')) {
    slider.slick('unslick');
  }

  slider.slick({
  slidesToShow: 1,
  slidesToScroll: 1,
  arrows: true,
  dots: true,
  infinite: false,
  autoplay: true,
  autoplaySpeed: 4000,
  speed: 700,
  adaptiveHeight: true,
  pauseOnHover: false,
  mobileFirst: true
});

});

</script>