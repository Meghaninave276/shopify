<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css"/>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css"/>

<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<section class="custom-slider">
  <div class="slider-wrapper multiple-items">
    
    {% for block in section.blocks %}
      <div class="slide">
        
        <div class="slide-inner"
          {% if block.settings.image != blank %}
            style="background-image: url({{ block.settings.image | image_url: width: 1600 }});"
          {% endif %}
        >

          <div class="overlay"></div>

          <div class="slide-content">
            <h2>{{ block.settings.heading }}</h2>
            <p>{{ block.settings.subtext }}</p>

            {% if block.settings.button_link != blank %}
              <a href="{{ block.settings.button_link }}" class="btn">
                {{ block.settings.button_text }}
              </a>
            {% endif %}
          </div>

        </div>

      </div>
    {% endfor %}

  </div>
</section>

<style>
.custom-slider {
  overflow: hidden;
}

/* Slide */
.slide {
  padding: 0;
}

.slide-inner {
  height: 600px;
  background-size: cover;
  background-position: center;
  position: relative;
}

/* Dark overlay for readability */
.overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.35);
}

/* Content */
.slide-content {
  position: absolute;
  top: 50%;
  left: 10%;
  transform: translateY(-50%);
  color: #fff;
  max-width: 500px;
}

.slide-content h2 {
  font-size: 42px;
  margin-bottom: 10px;
}

.slide-content p {
  font-size: 18px;
  margin-bottom: 20px;
}

/* Button */
.btn {
  padding: 12px 25px;
  background: #000;
  color: #fff;
  text-decoration: none;
  display: inline-block;
}

/* Responsive */
@media(max-width:768px){
  .slide-inner {
    height: 400px;
  }

  .slide-content {
    left: 5%;
  }

  .slide-content h2 {
    font-size: 28px;
  }
}
</style>

<script>
function initSlickSlider() {
  var $slider = $('.multiple-items');

  if ($slider.length) {

    // Destroy if already initialized (Shopify fix)
    if ($slider.hasClass('slick-initialized')) {
      $slider.slick('unslick');
    }

    $slider.slick({
      infinite: true,
      slidesToShow: 1,
      slidesToScroll: 1,
      autoplay: true,
      autoplaySpeed: 3000,
      dots: true,
      arrows: true,
      fade: true, // smooth fade effect
      speed: 800
    });
  }
}

/* Load */
document.addEventListener("DOMContentLoaded", function () {
  initSlickSlider();
});

/* Shopify Editor Fix */
document.addEventListener("shopify:section:load", function () {
  initSlickSlider();
});
</script>

{% schema %}
{
  "name": "Custom Slider",
  "settings": [],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Background Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Your Heading"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Your description here"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button Text",
          "default": "Shop Now"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}